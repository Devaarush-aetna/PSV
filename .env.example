# Copy this file to .env and fill in your values
# cp .env.example .env

# ── Anthropic Claude API ──────────────────────────────────────────────────────
# Required: your Anthropic API key (get one at https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the default model (defaults to claude-sonnet-4-6)
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── CVS Enterprise Gateway (only needed on CVS corporate network) ─────────────
# If you are on the CVS network, set these instead of ANTHROPIC_API_KEY above
# ANTHROPIC_BASE_URL=https://hyperion-lms-api.prod.cvshealth.com
# ANTHROPIC_CUSTOM_HEADERS="X-Client-Name: YOUR_ID\nX-Client-Version: 1.5.5\nX-Client-Platform: win32\nX-Client-Arch: x64\nX-Client-Env: prod\nX-Client-Timezone: America/New_York\nX-Client-User: cvscode\nX-Client-CI: false\nX-Client-Terminal: unknown\nX-Client-Runtime: bun/1.3.14"
